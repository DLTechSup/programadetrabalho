{
  "name": "gradefacil",
  "productName": "GradeFacil",
  "version": "3.0.0",
  "description": "Preenche planilhas de produtos do Bling: PAI, variações, cores, códigos e descrições.",
  "author": "DL Tech",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "app": "vite build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "br.com.dltech.gradefacil",
    "productName": "GradeFacil",
    "artifactName": "GradeFacil-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "language": "1046"
    }
  }
}
