{
  "name": "gradefacil",
  "productName": "GradeFacil",
  "version": "3.0.0",
  "description": "Preenche planilhas de produtos do Bling: PAI, variações, cores, códigos e descrições.",
  "author": "DL Tech",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:electron-logic": "esbuild src/apps/monitor/paraElectron.ts --bundle --platform=node --format=cjs --outfile=electron/monitor/logica-pura.cjs --target=node18",
    "app": "npm run build:electron-logic && vite build && electron .",
    "build": "npm run build:electron-logic && tsc --noEmit && vite build",
    "test": "vitest run",
    "autoteste:monitor": "npm run build:electron-logic && electron scripts/autoteste-monitor.cjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/extension-task-item": "^3.34.0",
    "@tiptap/extension-task-list": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extension-text-style": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "lucide-react": "^1.72.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.16.0",
    "tesseract.js": "^7.0.0",
    "uiohook-napi": "^1.5.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "br.com.dltech.gradefacil",
    "productName": "GradeFacil",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sql.js/dist/*.wasm"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "language": "1046",
      "artifactName": "GradeFacil-Instalador-${version}.${ext}"
    },
    "portable": {
      "artifactName": "GradeFacil-Portatil-${version}.${ext}"
    }
  }
}
