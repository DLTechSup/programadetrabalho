{
  "name": "reparo-otimizacao-windows",
  "productName": "ReparoWindows",
  "version": "1.0.0",
  "description": "Diagnóstico, limpeza de disco, otimização e reparo do Windows (disco cheio, lentidão, memória, internet).",
  "author": "DL Tech",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "app": "vite build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "smoke": "node scripts/smoke-windows.cjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "br.com.dltech.reparowindows",
    "productName": "ReparoWindows",
    "directories": { "output": "release" },
    "files": ["dist/**", "electron/**", "package.json"],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "language": "1046",
      "artifactName": "ReparoWindows-Instalador-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ReparoWindows-Portatil-${version}.${ext}"
    }
  }
}
