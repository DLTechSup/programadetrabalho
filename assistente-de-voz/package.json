{
  "name": "assistente-de-voz",
  "productName": "AssistenteDeVoz",
  "version": "1.0.0",
  "description": "Assistente controlado por voz para Windows: abre pastas (marca/referência), programas, navegador, janelas e volume.",
  "author": "DL Tech",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "preparar": "node scripts/copiar-ort.cjs",
    "predev": "npm run preparar",
    "dev": "vite",
    "prebuild": "npm run preparar",
    "build": "tsc --noEmit && vite build",
    "preapp": "npm run preparar",
    "app": "vite build && electron .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@huggingface/transformers": "^3.7.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "br.com.dltech.assistentevoz",
    "productName": "AssistenteDeVoz",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "language": "1046",
      "artifactName": "AssistenteDeVoz-Instalador-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AssistenteDeVoz-Portatil-${version}.${ext}"
    }
  },
  "dependencies": {}
}
