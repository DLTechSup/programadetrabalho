{
  "name": "projeta-moveis",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron": "electron .",
    "app": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir --publish never"
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svg2pdf.js": "^2.2.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "productName": "Projeta Móveis",
  "description": "Projetos executivos de marcenaria: desenho técnico, plano de corte, materiais e orçamento",
  "author": "Projeta Móveis",
  "main": "electron/main.cjs",
  "build": {
    "appId": "br.com.projetamoveis.app",
    "productName": "Projeta Móveis",
    "copyright": "Projeta Móveis",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "pmv",
        "name": "Projeto Projeta Móveis",
        "description": "Projeto Projeta Móveis",
        "icon": "build/icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Projeta Móveis",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "artifactName": "Instalador-Projeta-Moveis-${version}.exe"
    },
    "portable": {
      "artifactName": "Projeta-Moveis-Portatil-${version}.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DLTechSup/moveisplanos.git"
  },
  "homepage": "./"
}
